# ─────────────────────────────────────────────────────────────────────────────
# SEO Workbench — configuration
#
# YOU DO NOT NEED ANY OF THIS. Copy to `.env` only if you want the two extras
# described below. With an empty file the tool crawls, audits, writes fixes,
# generates content and makes social artwork using free keyless services.
#
# Run "System check" in the sidebar to see what's reachable from your machine.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4321

# ── OPTIONAL 1: free Google API key ─────────────────────────────────────────
# Turns the performance SNAPSHOT into six months of weekly trend lines, and
# lifts PageSpeed from ~25 requests/day to effectively unlimited.
# Without it you still get today's real-user field data via PageSpeed.
#   console.cloud.google.com → APIs & Services → Library
#   → enable "PageSpeed Insights API" and "Chrome UX Report API"
#   → Credentials → Create credentials → API key
GOOGLE_API_KEY=

# ── OPTIONAL 2: Search Console ──────────────────────────────────────────────
# Swaps DuckDuckGo visibility estimates for real Google positions, clicks and
# impressions on the queries you already appear for. This is the single biggest
# upgrade available, because it's Google's own record of your site.
#   console.cloud.google.com → enable "Google Search Console API"
#   → OAuth consent screen → External → add yourself as a Test user
#   → Credentials → OAuth client ID → Web application
#   → Authorised redirect URI, exactly:
#        http://localhost:4321/api/gsc/callback
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:4321/api/gsc/callback

# ── Better quality, if you happen to have keys ───────────────────────────────
# Writing works out of the box on free keyless models. These only improve it.
# ANTHROPIC_API_KEY moves to the front of the text provider chain.
# Cloudflare Workers AI (free daily allowance) replaces the keyless image
# provider and is markedly more reliable.
ANTHROPIC_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Crawl defaults ───────────────────────────────────────────────────────────
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=250
CRAWL_TIMEOUT_MS=15000
