# ─────────────────────────────────────────────────────────────────────────────
# SEO Workbench — configuration
#
# FOR LOCAL USE: You do not need any of this to start.
# FOR VERCEL DEPLOYMENT: Configure SESSION_SECRET and optional Firebase keys below.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4321

# ── Production & Security (Critical for Vercel) ──────────────────────────────
# Generate a 32+ character secret for cryptographically signing session cookies.
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true to enforce login everywhere. Automatically active on Vercel.
FORCE_AUTH=true

# Optional: Custom directory for storing app data.
# Defaults to `/tmp/data` on Vercel, and `./data` locally.
DATA_DIR=

# ── Firebase Authentication (Google One-Click & Team Accounts) ───────────────
# Firebase Console → Project Settings → General → Your apps → Web app config
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=seo-workbench-prod
FIREBASE_AUTH_DOMAIN=seo-workbench-prod.firebaseapp.com
FIREBASE_APP_ID=

# ── Google API key (PageSpeed & CrUX) ─────────────────────────────────────────
# Turns the performance SNAPSHOT into six months of weekly trend lines, and
# lifts PageSpeed from ~25 requests/day to effectively unlimited.
#   console.cloud.google.com → APIs & Services → Library
#   → enable "PageSpeed Insights API" and "Chrome UX Report API"
#   → Credentials → Create credentials → API key
GOOGLE_API_KEY=

# ── Google Search Console ───────────────────────────────────────────────────
# Swaps DuckDuckGo visibility estimates for real Google positions, clicks and
# impressions on the queries you already appear for.
#   console.cloud.google.com → enable "Google Search Console API"
#   → OAuth consent screen → External → add yourself as a Test user
#   → Credentials → OAuth client ID → Web application
#   → Authorised redirect URI (e.g. https://your-app.vercel.app/api/gsc/callback)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:4321/api/gsc/callback

# ── AI Models (Optional Quality Boost) ───────────────────────────────────────
# Writing works out of the box on free keyless models. These only improve it.
# ANTHROPIC_API_KEY moves to the front of the text provider chain.
# Cloudflare Workers AI replaces the keyless image provider for social posts.
ANTHROPIC_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Crawl defaults ───────────────────────────────────────────────────────────
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=250
CRAWL_TIMEOUT_MS=15000
